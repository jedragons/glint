{
    "version": 6,
    "cmakeMinimumRequired": {
        "major": 3,
        "minor": 25,
        "patch": 0
    },
    "configurePresets": [
        {
            "name": "base",
            "hidden": true,
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/${presetName}",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "CMAKE_EXPORT_COMPILE_COMMANDS": true,
                "GLINT_BUILD_TESTS": true
            }
        },
        {"name": "linux", "hidden": true, "inherits": "base", "condition": {"type": "equals", "lhs": "${hostSystemName}", "rhs": "Linux"}},
        {"name": "macos", "hidden": true, "inherits": "base", "condition": {"type": "equals", "lhs": "${hostSystemName}", "rhs": "Darwin"}},
        {"name": "windows", "hidden": true, "inherits": "base", "condition": {"type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows"}},
        {"name": "web-settings", "hidden": true, "inherits": "base", "cacheVariables": {"PLATFORM": "Web", "GLINT_BUILD_TESTS": false}},
        {
            "name": "default",
            "inherits": "base",
            "description": "Native compiler from the environment; compilation database: build/default/compile_commands.json."
        },
        {"name": "default-debug", "inherits": "default"},
        {"name": "default-release", "inherits": "default", "cacheVariables": {"CMAKE_BUILD_TYPE": "RelWithDebInfo"}},
        {"name": "debug", "inherits": "default-debug"},
        {"name": "release", "inherits": "default-release"},
        {
            "name": "linux-gcc-x86_64",
            "inherits": "linux",
            "description": "Linux x86_64 with gcc; cross builds require target libraries and a matching toolchain/sysroot.",
            "toolchainFile": "${sourceDir}/cmake/toolchains/linux.cmake",
            "cacheVariables": {
                "GLINT_TOOLCHAIN_COMPILER": "gcc",
                "GLINT_TARGET_ARCH": "x86_64"
            }
        },
        {"name": "linux-gcc-x86_64-debug", "inherits": "linux-gcc-x86_64"},
        {"name": "linux-gcc-x86_64-release", "inherits": "linux-gcc-x86_64", "cacheVariables": {"CMAKE_BUILD_TYPE": "RelWithDebInfo"}},
        {
            "name": "linux-gcc-arm64",
            "inherits": "linux",
            "description": "Linux arm64 with gcc; cross builds require target libraries and a matching toolchain/sysroot.",
            "toolchainFile": "${sourceDir}/cmake/toolchains/linux.cmake",
            "cacheVariables": {
                "GLINT_TOOLCHAIN_COMPILER": "gcc",
                "GLINT_TARGET_ARCH": "arm64"
            }
        },
        {"name": "linux-gcc-arm64-debug", "inherits": "linux-gcc-arm64"},
        {"name": "linux-gcc-arm64-release", "inherits": "linux-gcc-arm64", "cacheVariables": {"CMAKE_BUILD_TYPE": "RelWithDebInfo"}},
        {
            "name": "linux-tcc-x86_64",
            "inherits": "linux",
            "description": "Linux x86_64 with tcc; cross builds require target libraries and a matching toolchain/sysroot. Cross compiler: x86_64-tcc; C11 feature detection depends on CMake/TCC versions.",
            "toolchainFile": "${sourceDir}/cmake/toolchains/linux.cmake",
            "cacheVariables": {
                "GLINT_TOOLCHAIN_COMPILER": "tcc",
                "GLINT_TARGET_ARCH": "x86_64"
            }
        },
        {"name": "linux-tcc-x86_64-debug", "inherits": "linux-tcc-x86_64"},
        {"name": "linux-tcc-x86_64-release", "inherits": "linux-tcc-x86_64", "cacheVariables": {"CMAKE_BUILD_TYPE": "RelWithDebInfo"}},
        {
            "name": "linux-tcc-arm64",
            "inherits": "linux",
            "description": "Linux arm64 with tcc; cross builds require target libraries and a matching toolchain/sysroot. Cross compiler: arm64-tcc; C11 feature detection depends on CMake/TCC versions.",
            "toolchainFile": "${sourceDir}/cmake/toolchains/linux.cmake",
            "cacheVariables": {
                "GLINT_TOOLCHAIN_COMPILER": "tcc",
                "GLINT_TARGET_ARCH": "arm64"
            }
        },
        {"name": "linux-tcc-arm64-debug", "inherits": "linux-tcc-arm64"},
        {"name": "linux-tcc-arm64-release", "inherits": "linux-tcc-arm64", "cacheVariables": {"CMAKE_BUILD_TYPE": "RelWithDebInfo"}},
        {
            "name": "linux-clang-x86_64",
            "inherits": "linux",
            "description": "Linux x86_64 with clang; cross builds require target libraries and a matching toolchain/sysroot.",
            "toolchainFile": "${sourceDir}/cmake/toolchains/linux.cmake",
            "cacheVariables": {
                "GLINT_TOOLCHAIN_COMPILER": "clang",
                "GLINT_TARGET_ARCH": "x86_64"
            }
        },
        {"name": "linux-clang-x86_64-debug", "inherits": "linux-clang-x86_64"},
        {"name": "linux-clang-x86_64-release", "inherits": "linux-clang-x86_64", "cacheVariables": {"CMAKE_BUILD_TYPE": "RelWithDebInfo"}},
        {
            "name": "linux-clang-arm64",
            "inherits": "linux",
            "description": "Linux arm64 with clang; cross builds require target libraries and a matching toolchain/sysroot.",
            "toolchainFile": "${sourceDir}/cmake/toolchains/linux.cmake",
            "cacheVariables": {
                "GLINT_TOOLCHAIN_COMPILER": "clang",
                "GLINT_TARGET_ARCH": "arm64"
            }
        },
        {"name": "linux-clang-arm64-debug", "inherits": "linux-clang-arm64"},
        {"name": "linux-clang-arm64-release", "inherits": "linux-clang-arm64", "cacheVariables": {"CMAKE_BUILD_TYPE": "RelWithDebInfo"}},
        {
            "name": "macos-gcc",
            "inherits": "macos",
            "description": "Homebrew GCC; configures successfully, but current Raylib/Cocoa dependencies need Apple Blocks syntax unsupported by GCC.",
            "toolchainFile": "${sourceDir}/cmake/toolchains/macos.cmake",
            "cacheVariables": {
                "GLINT_TOOLCHAIN_COMPILER": "gcc"
            }
        },
        {"name": "macos-gcc-debug", "inherits": "macos-gcc"},
        {"name": "macos-gcc-release", "inherits": "macos-gcc", "cacheVariables": {"CMAKE_BUILD_TYPE": "RelWithDebInfo"}},
        {
            "name": "macos-homebrew-clang",
            "inherits": "macos",
            "description": "Homebrew homebrew-clang; requires brew on PATH.",
            "toolchainFile": "${sourceDir}/cmake/toolchains/macos.cmake",
            "cacheVariables": {
                "GLINT_TOOLCHAIN_COMPILER": "homebrew-clang"
            }
        },
        {"name": "macos-homebrew-clang-debug", "inherits": "macos-homebrew-clang"},
        {"name": "macos-homebrew-clang-release", "inherits": "macos-homebrew-clang", "cacheVariables": {"CMAKE_BUILD_TYPE": "RelWithDebInfo"}},
        {
            "name": "macos-clang",
            "inherits": "macos",
            "description": "Apple Clang (/usr/bin/clang).",
            "toolchainFile": "${sourceDir}/cmake/toolchains/macos.cmake",
            "cacheVariables": {
                "GLINT_TOOLCHAIN_COMPILER": "clang"
            }
        },
        {"name": "macos-clang-debug", "inherits": "macos-clang"},
        {"name": "macos-clang-release", "inherits": "macos-clang", "cacheVariables": {"CMAKE_BUILD_TYPE": "RelWithDebInfo"}},
        {
            "name": "windows-mingw-x86_64",
            "inherits": "base",
            "condition": {
                "type": "inList",
                "string": "${hostSystemName}",
                "list": [
                    "Linux",
                    "Darwin",
                    "Windows"
                ]
            },
            "description": "Windows x86_64 with MinGW-w64 GCC; cross tests use Wine when available.",
            "toolchainFile": "${sourceDir}/cmake/toolchains/mingw.cmake",
            "cacheVariables": {
                "GLINT_TARGET_ARCH": "x86_64",
                "CMAKE_C_COMPILER": "x86_64-w64-mingw32-gcc"
            }
        },
        {"name": "windows-mingw-x86_64-debug", "inherits": "windows-mingw-x86_64"},
        {"name": "windows-mingw-x86_64-release", "inherits": "windows-mingw-x86_64", "cacheVariables": {"CMAKE_BUILD_TYPE": "RelWithDebInfo"}},
        {
            "name": "windows-mingw-arm64",
            "inherits": "base",
            "condition": {
                "type": "inList",
                "string": "${hostSystemName}",
                "list": [
                    "Linux",
                    "Darwin",
                    "Windows"
                ]
            },
            "description": "Windows arm64 with LLVM-MinGW; cross tests require a compatible runner.",
            "toolchainFile": "${sourceDir}/cmake/toolchains/mingw.cmake",
            "cacheVariables": {
                "GLINT_TARGET_ARCH": "arm64",
                "CMAKE_C_COMPILER": "aarch64-w64-mingw32-clang"
            }
        },
        {"name": "windows-mingw-arm64-debug", "inherits": "windows-mingw-arm64"},
        {"name": "windows-mingw-arm64-release", "inherits": "windows-mingw-arm64", "cacheVariables": {"CMAKE_BUILD_TYPE": "RelWithDebInfo"}},
        {
            "name": "windows-msvc-x86_64",
            "inherits": "windows",
            "description": "Run from a Visual Studio x64 developer shell; requires Ninja.",
            "architecture": {
                "value": "x64",
                "strategy": "external"
            },
            "toolchainFile": "${sourceDir}/cmake/toolchains/msvc.cmake",
            "cacheVariables": {
                "GLINT_TARGET_ARCH": "x64",
                "CMAKE_C_COMPILER": "cl"
            }
        },
        {"name": "windows-msvc-x86_64-debug", "inherits": "windows-msvc-x86_64"},
        {"name": "windows-msvc-x86_64-release", "inherits": "windows-msvc-x86_64", "cacheVariables": {"CMAKE_BUILD_TYPE": "RelWithDebInfo"}},
        {
            "name": "windows-gcc-x86_64",
            "inherits": "windows",
            "description": "Requires a MinGW-w64 GCC distribution targeting x86_64 on PATH.",
            "toolchainFile": "${sourceDir}/cmake/toolchains/mingw.cmake",
            "cacheVariables": {
                "GLINT_TARGET_ARCH": "x86_64",
                "CMAKE_C_COMPILER": "x86_64-w64-mingw32-gcc"
            }
        },
        {"name": "windows-gcc-x86_64-debug", "inherits": "windows-gcc-x86_64"},
        {"name": "windows-gcc-x86_64-release", "inherits": "windows-gcc-x86_64", "cacheVariables": {"CMAKE_BUILD_TYPE": "RelWithDebInfo"}},
        {
            "name": "windows-msvc-arm64",
            "inherits": "windows",
            "description": "Run from a Visual Studio arm64 developer shell; requires Ninja.",
            "architecture": {
                "value": "arm64",
                "strategy": "external"
            },
            "toolchainFile": "${sourceDir}/cmake/toolchains/msvc.cmake",
            "cacheVariables": {
                "GLINT_TARGET_ARCH": "arm64",
                "CMAKE_C_COMPILER": "cl"
            }
        },
        {"name": "windows-msvc-arm64-debug", "inherits": "windows-msvc-arm64"},
        {"name": "windows-msvc-arm64-release", "inherits": "windows-msvc-arm64", "cacheVariables": {"CMAKE_BUILD_TYPE": "RelWithDebInfo"}},
        {
            "name": "windows-gcc-arm64",
            "inherits": "windows",
            "description": "Requires a MinGW-w64 GCC distribution targeting arm64 on PATH.",
            "toolchainFile": "${sourceDir}/cmake/toolchains/mingw.cmake",
            "cacheVariables": {
                "GLINT_TARGET_ARCH": "arm64",
                "CMAKE_C_COMPILER": "aarch64-w64-mingw32-gcc"
            }
        },
        {"name": "windows-gcc-arm64-debug", "inherits": "windows-gcc-arm64"},
        {"name": "windows-gcc-arm64-release", "inherits": "windows-gcc-arm64", "cacheVariables": {"CMAKE_BUILD_TYPE": "RelWithDebInfo"}},
        {
            "name": "emscripten",
            "inherits": "web-settings",
            "condition": {
                "type": "inList",
                "string": "${hostSystemName}",
                "list": [
                    "Linux",
                    "Darwin",
                    "Windows"
                ]
            },
            "description": "Browser wasm32; just configure invokes emcmake on Linux, macOS and Windows."
        },
        {"name": "emscripten-debug", "inherits": "emscripten"},
        {"name": "emscripten-release", "inherits": "emscripten", "cacheVariables": {"CMAKE_BUILD_TYPE": "MinSizeRel"}}
    ],
