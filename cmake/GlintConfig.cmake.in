@PACKAGE_INIT@

if(TARGET Glint::glint)
    return()
endif()

include(CMakeFindDependencyMacro)
set(_glint_prefix "${PACKAGE_PREFIX_DIR}")
find_dependency(raylib CONFIG PATHS "${CMAKE_CURRENT_LIST_DIR}/../raylib" NO_DEFAULT_PATH)

# Lua is vendored and installed alongside Glint, but has no upstream CMake export.
if(NOT TARGET Glint::lua)
    add_library(Glint::lua STATIC IMPORTED)
    set_target_properties(Glint::lua PROPERTIES
        IMPORTED_LOCATION "${_glint_prefix}/lib/@CMAKE_STATIC_LIBRARY_PREFIX@lua@CMAKE_STATIC_LIBRARY_SUFFIX@"
        INTERFACE_INCLUDE_DIRECTORIES "${_glint_prefix}/include")
    if(CMAKE_DL_LIBS)
        set_property(TARGET Glint::lua APPEND PROPERTY INTERFACE_LINK_LIBRARIES "${CMAKE_DL_LIBS}")
    endif()
endif()

# raylib's installed target omits its private static platform dependencies.
if(NOT "@BUILD_SHARED_LIBS@")
    if(EMSCRIPTEN)
        # Emscripten provides the platform APIs through its toolchain.
    elseif(APPLE)
        set_property(TARGET raylib APPEND PROPERTY INTERFACE_LINK_LIBRARIES
            "-framework Cocoa" "-framework IOKit" "-framework CoreFoundation" "-framework OpenGL")
    elseif(WIN32)
        set_property(TARGET raylib APPEND PROPERTY INTERFACE_LINK_LIBRARIES opengl32 gdi32 winmm)
    elseif(UNIX)
        find_dependency(Threads)
        find_dependency(OpenGL)
        find_dependency(X11)
        set_property(TARGET raylib APPEND PROPERTY INTERFACE_LINK_LIBRARIES
            Threads::Threads OpenGL::GL X11::X11 ${CMAKE_DL_LIBS})
    endif()
endif()

include("${CMAKE_CURRENT_LIST_DIR}/GlintTargets.cmake")
unset(_glint_prefix)
check_required_components(Glint)
