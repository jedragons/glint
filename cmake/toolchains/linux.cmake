list(APPEND CMAKE_TRY_COMPILE_PLATFORM_VARIABLES GLINT_TARGET_ARCH GLINT_TOOLCHAIN_COMPILER)

if(GLINT_TARGET_ARCH STREQUAL "arm64")
    set(target_processor aarch64)
else()
    set(target_processor x86_64)
endif()

set(host_processor "${CMAKE_HOST_SYSTEM_PROCESSOR}")
if(host_processor STREQUAL "arm64")
    set(host_processor aarch64)
endif()

if(NOT host_processor STREQUAL target_processor)
    set(CMAKE_SYSTEM_NAME Linux)
    set(CMAKE_SYSTEM_PROCESSOR "${target_processor}")
    set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
    set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
    set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
    set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)
endif()

if(NOT CMAKE_C_COMPILER)
    if(GLINT_TOOLCHAIN_COMPILER STREQUAL "clang")
        set(CMAKE_C_COMPILER clang)
    elseif(host_processor STREQUAL target_processor)
        set(CMAKE_C_COMPILER "${GLINT_TOOLCHAIN_COMPILER}")
    elseif(GLINT_TOOLCHAIN_COMPILER STREQUAL "tcc")
        set(CMAKE_C_COMPILER "${GLINT_TARGET_ARCH}-tcc")
    else()
        set(CMAKE_C_COMPILER "${target_processor}-linux-gnu-gcc")
    endif()
endif()

if(GLINT_TOOLCHAIN_COMPILER STREQUAL "clang")
    set(CMAKE_C_COMPILER_TARGET "${target_processor}-linux-gnu")
endif()
